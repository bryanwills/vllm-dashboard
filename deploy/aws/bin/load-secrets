#!/bin/bash
set -euo pipefail

output_path=$1
secret_arns_path=/etc/alerting/secret-arns
temporary_path=$(mktemp "${output_path}.XXXXXX")

cleanup() {
  rm -f "$temporary_path"
}
trap cleanup EXIT HUP INT TERM

while IFS= read -r secret_arn; do
  if [ -n "$secret_arn" ]; then
    aws secretsmanager get-secret-value \
      --secret-id "$secret_arn" \
      --output json \
      | /opt/alerting/venv/bin/python /opt/alerting/bin/render-secret-env \
        >> "$temporary_path"
  fi
done < "$secret_arns_path"

chmod 0600 "$temporary_path"
mv "$temporary_path" "$output_path"
trap - EXIT HUP INT TERM
