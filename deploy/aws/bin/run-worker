#!/bin/bash
set -euo pipefail

consumer=$1
credentials_path="/run/alerting/${consumer}.env"

cleanup() {
  rm -f "$credentials_path"
}
trap cleanup EXIT HUP INT TERM

/opt/alerting/bin/load-secrets "$credentials_path"
set -a
# shellcheck disable=SC1091 -- generated from validated Secrets Manager JSON
source /etc/alerting/worker.env
# shellcheck disable=SC1090 -- generated from validated Secrets Manager JSON
source "$credentials_path"
set +a
rm -f "$credentials_path"
trap - EXIT HUP INT TERM

exec /opt/alerting/venv/bin/python -m alerting.worker "$consumer"
